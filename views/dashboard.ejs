<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Boost Order - Hydra Boosting' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'dashboard' }) %>
  <%- include('partials/drawer', { active: 'dashboard' }) %>

  <main class="page">
    <div class="container">
      <h1 class="page-title">Place a Boost Order</h1>
      <p class="page-subtitle">Choose a platform, tell us where to boost, and we’ll handle the rest.</p>

      <% if (flash) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <div class="card">
        <form id="orderForm" action="/orders" method="POST" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />

          <div class="form-group">
              <label for="category">🌐 Platform</label>
            <select id="category" name="category" required>
                <option value="" disabled selected>Select a platform</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
              <label for="serviceId">✨ Service</label>
            <select id="serviceId" name="serviceId" required disabled>
              <option value="" disabled selected>Select category first</option>
            </select>
            <p id="serviceHint" class="field-hint"></p>
          </div>

          <div class="form-group">
              <label for="link">🔗 Link</label>
            <input
              type="url"
              id="link"
              name="link"
              placeholder="https://facebook.com/your-page"
              required
            />
          </div>

          <div class="form-group">
              <label for="quantity">📈 Quantity</label>
            <input
              type="number"
              id="quantity"
              name="quantity"
              min="1"
              placeholder="e.g. 1000"
              required
            />
            <p id="quantityHint" class="field-hint"></p>
          </div>

          <div class="total-box">
            <span class="total-label">Total Charge</span>
            <span id="totalValue" class="total-value">PHP 0.00</span>
          </div>

              <button id="submitOrderBtn" type="submit" class="btn btn-primary btn-block" disabled>
             🚀 Place Boost Order
          </button>
        </form>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <strong>Hydra Boosting</strong>
    <span>Simple, transparent social media growth services with secure account management and real-time order tracking.</span>
    <small>Use only on accounts and content you own or are authorized to manage.</small>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
