<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Boost Order - GE Boost Market' }) %>
</head>
<body>
  <%- include('partials/navbar', { active: 'dashboard' }) %>
  <%- include('partials/drawer', { active: 'dashboard' }) %>

  <main class="page">
    <div class="container">
      <h1 class="page-title">Boost Starts Here</h1>
      <p class="page-subtitle">Choose your platform, enter your order details, and let GE handle the boost.</p>

      <% if (flash) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <div class="card">
        <form id="orderForm" action="/orders" method="POST" novalidate>
          <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />

          <div class="form-group">
              <label for="category">🌐 Select Network</label>
            <select id="category" name="category" required>
                <option value="" disabled selected>Select a platform</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
              <label for="serviceId">✨ Choose Boost</label>
            <select id="serviceId" name="serviceId" required disabled>
              <option value="" disabled selected>Select category first</option>
            </select>
            <p id="serviceHint" class="field-hint"></p>
          </div>

          <div class="form-group">
              <label for="link">🔗 Drop Your Link</label>
            <input
              type="url"
              id="link"
              name="link"
              placeholder="https://platform.com/your-account"
              required
            />
          </div>

          <div class="form-group">
              <label for="quantity">📈 Set Your Reach</label>
            <input
              type="number"
              id="quantity"
              name="quantity"
              min="1"
              placeholder="e.g. 100"
              required
            />
            <p id="quantityHint" class="field-hint"></p>
          </div>

          <div class="total-box">
            <span class="total-label">💵 Final Amount</span>
            <span id="totalValue" class="total-value">Credits 0.00</span>
          </div>

              <button id="submitOrderBtn" type="submit" class="btn btn-primary btn-block" disabled>
             🚀 Place Boost Order
          </button>
        </form>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <strong>GE Boost Market</strong>
    <span>Reliable and streamlined social media growth services designed to help you manage your online presence with ease. Select your preferred platform and service, place your order securely, and monitor its progress through our convenient tracking system.</span>
    <small>Please use our services only for accounts and content that you own or are authorized to manage.</small>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>

