<!doctype html><html lang="en"><head><%- include('partials/head', { title: 'Admin Console · Hydra Boosting' }) %></head>
<body><header class="topbar"><div class="brand"><img class="brand-icon" src="/icon.png" alt="Hydra Boosting" /><span class="brand-name">Hydra <em>Control</em></span></div><form action="/logout" method="post"><button class="btn btn-outline">Logout</button></form></header>
<main class="page"><div class="container wide"><div class="page-header-row"><div><p class="eyebrow">ADMIN CONSOLE</p><h1 class="page-title">Keep the panel moving.</h1><p class="page-subtitle">Manage balances, access, maintenance, and fulfillment from one place.</p></div></div>
<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.message %></div><% } %>
<section class="card admin-toggle"><div><strong>Maintenance mode</strong><p class="field-hint">Regular users see a maintenance screen; you stay operational.</p></div><form action="/admin/maintenance" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label class="switch"><input type="checkbox" name="enabled" <%= settings.maintenanceMode ? 'checked' : '' %> onchange="this.form.submit()"><span></span></label></form></section>
<section><div class="section-heading"><h2>Users</h2><span class="muted"><%= users.length %> registered</span></div><div class="table-wrap"><table><thead><tr><th>Username</th><th>Credits</th><th>Session</th><th>Last login</th><th>Access</th><th>Credits</th></tr></thead><tbody><% users.forEach(u => { %><tr><td><strong><%= u.username %></strong></td><td class="gold">PHP <%= Number(u.balance).toFixed(2) %></td><td><span class="session-dot <%= u.isActive ? 'online' : '' %>"></span><%= u.isActive ? 'Online' : 'Offline' %></td><td><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString() : 'Never' %></td><td><form action="/admin/users/<%= u.id %>/ban" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button class="text-btn"><%= u.banned ? '🔓 Unban' : '🔒 Ban' %></button></form></td><td><form class="inline-form" action="/admin/users/<%= u.id %>/balance" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><select name="mode"><option value="add">Add</option><option value="deduct">Deduct</option><option value="set">Set</option></select><input name="amount" type="number" min="0" step=".01" placeholder="PHP amount" required><button class="btn btn-small">Apply</button></form></td></tr><% }) %></tbody></table></div></section>
<section><div class="section-heading"><h2>Order history</h2><span class="muted"><%= orders.length %> total</span></div><div class="table-wrap"><table><thead><tr><th>Service</th><th>User</th><th>Quantity</th><th>Charge</th><th>Status</th></tr></thead><tbody><% orders.forEach(o => { const owner = users.find(u => u.id === o.userId); %><tr><td><%= o.serviceName %></td><td><%= owner ? owner.username : 'Unknown' %></td><td><%= Number(o.quantity).toLocaleString() %></td><td class="gold">PHP <%= Number(o.totalCharge).toFixed(2) %></td><td><span class="status-badge status-<%= String(o.status).toLowerCase().replace(' ', '-') %>"><%= o.status %></span></td></tr><% }) %></tbody></table></div></section>
</div></main></body></html>