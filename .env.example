PORT=3000
NODE_ENV=production
SITE_URL=https://your-domain.example

# Session / Security
SESSION_SECRET=replace-with-a-long-random-secret

# JTSMM Panel API (server-side only, never exposed to users)
BASE_API_URL=https://jtsmmpanel.com/api/v2
API_KEY=replace-with-your-provider-api-key

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret

# Wallet
SIGNUP_BONUS_PHP=0
TIKTOK_COMMENT_SERVICE_ID=
TIKTOK_COMMENT_PRICE=

# Admin access
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=DerekDekDek@200401

# Firebase Admin SDK (backend only)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
# Option A: one-line JSON service account (recommended for Railway)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: separate service-account variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Keep the private key in Railway Secrets. Use \n for line breaks when stored as one value.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Admin contact
ADMIN_TELEGRAM=https://t.me/your-support-account